{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Translate",
  "version": "1.7.0",
  "version_name": "1.7.0",
  "minimum_chrome_version": "105",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Hayk Jomardyan",
  "homepage_url": "https://github.com/jomardyan/xt1-Right-Click-Translate",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "translate-selection": {
      "description": "__MSG_commandTranslateSelection__",
      "suggested_key": {
        "default": "Alt+Shift+T"
      }
    },
    "translate-page": {
      "description": "__MSG_commandTranslatePage__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionTitle__"
  }
}
